<?xml version="1.0" encoding="UTF-8"?>
<Context>
    <!--
        Declaramos explícitamente el FormAuthenticator para poder fijar
        'landingPage'. Cuando se hace POST a j_security_check pero ya no
        existe el "saved request" en la sesión (sesión caducada o login
        enviado desde la caché del navegador tras un logout), Tomcat
        devuelve por defecto un HTTP 408 (Request Timeout). Con landingPage
        configurada, en ese caso redirige a esta página en lugar de fallar.
    -->
    <Valve className="org.apache.catalina.authenticator.FormAuthenticator"
           landingPage="/NOL/index.html" />
</Context>
